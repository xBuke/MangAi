{
  "redirects": [
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "www.mangai.hr"
        }
      ],
      "destination": "https://mangai.hr/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/en/blog",
      "destination": "/en/blog/",
      "permanent": true
    },
    {
      "source": "/en/blog/index.html",
      "destination": "/en/blog/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      320,
      480,
      600,
      640,
      800,
      960,
      1100,
      1200,
      1400,
      1600,
      2000
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "cerinrestaurant.lovable.app",
        "pathname": "/**"
      }
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2678400
  }
}
